<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OpenPath.UI.ViewModels"
    xmlns:model="using:OpenPath.UI.Models"
    x:DataType="vm:ExplorerViewModel"
    x:Class="OpenPath.UI.Views.ExplorerView">

    <UserControl.DataContext>
        <vm:ExplorerViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>

        <LinearGradientBrush x:Key="GlassMenuBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FAFFFFFF" Offset="0"/>
            <GradientStop Color="#F0F7FBFF" Offset="0.55"/>
            <GradientStop Color="#E2EEF7FF" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="SettingsPanelBackground" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SettingsPanelBorder" Color="#D8E0EA"/>
        <SolidColorBrush x:Key="SettingsTextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="SettingsTextSecondary" Color="#64748B"/>

        <ControlTheme x:Key="GlassContextMenuTheme" TargetType="ContextMenu">
            <Setter Property="MinWidth" Value="280"/>
            <Setter Property="MaxWidth" Value="360"/>
            <Setter Property="Background" Value="{DynamicResource GlassMenuBackground}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="#90FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="8">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="2"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ContextMenu x:Key="FileContextMenu">
            <MenuItem Header="Abrir" Click="OnOpenFileClickMenuItem"/>
            <MenuItem Header="Deletar" Click="OnDeleteClick"/>
            <MenuItem Header="Renomear" Click="OnRenameClick"/>
            <Separator/>
            <MenuItem Header="Atualizar" Click="OnRefreshClick"/>
            <MenuItem Header="Copiar path" Click="OnCopyPathClick"/>
        </ContextMenu>

        <ContextMenu x:Key="FolderContextMenu">
            <MenuItem Header="Abrir" Click="OnOpenFolderClickMenuItem"/>
            <MenuItem Header="Deletar" Click="OnDeleteClick"/>
            <MenuItem Header="Renomear" Click="OnRenameClick"/>
            <Separator/>
            <MenuItem Header="Atualizar" Click="OnRefreshClick"/>
            <MenuItem Header="Copiar path" Click="OnCopyPathClick"/>
        </ContextMenu>

        <ContextMenu x:Key="BackgroundContextMenu">
            <MenuItem Header="Atualizar" Click="OnRefreshClick"/>
            <MenuItem Header="Novo">
                <MenuItem Header="Novo arquivo" Click="OnNewFileClick"/>
                <MenuItem Header="Nova pasta" Click="OnNewFolderClick"/>
            </MenuItem>
        </ContextMenu>

    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="ContextMenu">
            <Setter Property="Theme" Value="{StaticResource GlassContextMenuTheme}" />
        </Style>

        <Style Selector="ContextMenu MenuItem">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ContextMenu MenuItem:pointerover">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>

        <Style Selector="ContextMenu MenuItem:pressed">
            <Setter Property="Background" Value="#99FFFFFF" />
        </Style>

        <Style Selector="ContextMenu Separator">
            <Setter Property="Margin" Value="8,6" />
        </Style>

        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="58,*" Background="#EEF2F7">

        <Border
            Grid.Row="0"
            Background="#F7F8FA"
            BorderBrush="#E5E7EB"
            BorderThickness="0,0,0,1"
            Padding="12,0">

            <Grid ColumnDefinitions="Auto,Auto,Auto,*,260" VerticalAlignment="Center">

                <Button
                    Width="28"
                    Height="28"
                    Margin="0,0,6,0"
                    Background="#FFFFFF"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="14"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <TextBlock
                        Text="☰"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#4B5563" />

                    <Button.Flyout>
                        <Flyout>
                            <Border
                                Width="290"
                                Padding="14"
                                Background="{DynamicResource SettingsPanelBackground}"
                                BorderBrush="{DynamicResource SettingsPanelBorder}"
                                BorderThickness="1"
                                CornerRadius="16">

                                <StackPanel Spacing="14">

                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Text="Configurações"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SettingsTextPrimary}" />
                                        <TextBlock
                                            Text="Ajustes do OpenPath"
                                            FontSize="12"
                                            Foreground="{DynamicResource SettingsTextSecondary}" />
                                    </StackPanel>

                                    <Border
                                        Background="#FFFFFF"
                                        BorderBrush="#E5EAF1"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Text="Tema"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SettingsTextPrimary}" />

                                            <StackPanel Spacing="8">
                                                <RadioButton Content="Claro" GroupName="AppTheme"/>
                                                <RadioButton Content="Escuro" GroupName="AppTheme"/>
                                                <RadioButton Content="Sistema" GroupName="AppTheme"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Background="#FFFFFF"
                                        BorderBrush="#E5EAF1"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Text="Outras opções"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SettingsTextPrimary}" />

                                            <StackPanel Spacing="8">
                                                <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
                                                    <TextBlock Text="• Aparência dos arquivos" Foreground="#1F2937"/>
                                                </Button>

                                                <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
                                                    <TextBlock Text="• Navegação" Foreground="#1F2937"/>
                                                </Button>

                                                <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
                                                    <TextBlock Text="• Atalhos" Foreground="#1F2937"/>
                                                </Button>

                                                <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
                                                    <TextBlock Text="• Sobre" Foreground="#1F2937"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    Margin="0,0,6,0"
                    Background="#FFFFFF"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="14"
                    Click="OnBackClick">
                    <TextBlock
                        Text="‹"
                        FontSize="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#4B5563" />
                </Button>

                <Button
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    Margin="0,0,12,0"
                    Background="#FFFFFF"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="14"
                    Click="OnForwardClick">
                    <TextBlock
                        Text="›"
                        FontSize="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#4B5563" />
                </Button>

                <Border
                    Grid.Column="3"
                    Height="34"
                    Margin="0,0,12,0"
                    Background="#EEF1F5"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="12"
                    VerticalAlignment="Center"
                    Padding="10,0">

                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding CurrentDirectory.Path}"
                            VerticalAlignment="Center"
                            Foreground="#1F2937"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="4"
                    Background="#EEF1F5"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="12"
                    Height="34"
                    VerticalAlignment="Center"
                    Padding="10,0">
                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <TextBlock
                            Text="⌕"
                            FontSize="15"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="#6B7280" />

                        <TextBox
                            Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            PlaceholderText="Pesquisar"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="280,6,*,6,Auto" MinWidth="0">

            <Border
                Grid.Column="0"
                Background="#FAFBFD"
                BorderBrush="#E5EAF1"
                BorderThickness="0,0,1,0"
                HorizontalAlignment="Stretch">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="14,18,14,18">

                    <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                        <TextBlock
                            Text="Favoritos"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#65758B" />

                        <StackPanel Spacing="8" HorizontalAlignment="Stretch">

                            <Button
                                 Background="Transparent"
                                BorderThickness="0"
                                Padding="10,9"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnHomeClick">
                                <TextBlock Text="🏠 Início" Foreground="#1F2937" />
                            </Button>

                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,9"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnDocumentClick">
                                <TextBlock Text="📂 Documentos" Foreground="#1F2937" />
                            </Button>

                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,9"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnDownloadClick">
                                <TextBlock Text="📥 Downloads" Foreground="#1F2937" />
                            </Button>

                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,9"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left">
                                <TextBlock Text="🖼️ Imagens" Foreground="#1F2937" />
                            </Button>

                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,9"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnFavoritesClick">
                                <TextBlock Text="⭐ Favoritos" Foreground="#1F2937" />
                            </Button>

                        </StackPanel>

                        <Border
                            Height="1"
                            Background="#E5EAF1"
                            Margin="0,4,0,4"/>

                        <StackPanel Spacing="8">

                            <TextBlock
                                Text="Discos"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#65758B"/>

                            <ItemsControl ItemsSource="{Binding Partitions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="model:Partition">
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="OnPartitionClick">

                                            <Border
                                                Background="#FFFFFF"
                                                BorderBrush="#E5EAF1"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Margin="0,0,0,8"
                                                Padding="12">

                                                <Grid RowDefinitions="Auto,Auto"
                                                      ColumnDefinitions="Auto,*">

                                                    <Border
                                                        Width="34"
                                                        Height="34"
                                                        Background="#F3F6FB"
                                                        BorderBrush="#E7EDF6"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="💽"
                                                            FontSize="16"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        Spacing="1">

                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="#1F2937"/>

                                                        <TextBlock
                                                            Text="{Binding DriveFormat}"
                                                            FontSize="11"
                                                            Foreground="#64748B"/>
                                                    </StackPanel>

                                                    <Grid
                                                        Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Margin="0,10,0,0"
                                                        ColumnDefinitions="*,Auto">

                                                        <TextBlock
                                                            Text="{Binding DriveType}"
                                                            FontSize="11"
                                                            Foreground="#64748B"/>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="11"
                                                            Foreground="#64748B">
                                                            <Run Text="{Binding TotalFreeGB}"/>
                                                            <Run Text=" GB livre de"/>
                                                            <Run Text="{Binding TotalGB}"/>
                                                            <Run Text=" GB"/>
                                                        </TextBlock>
                                                    </Grid>

                                                </Grid>

                                            </Border>

                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ShowsPreview="True"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext" />

            <Border
                Grid.Column="2"
                Background="Transparent"
                ContextMenu="{StaticResource BackgroundContextMenu}"
                ContextRequested="OnBackgroundContextRequested">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="20,20,20,80">

                    <Grid RowDefinitions="Auto,Auto,Auto" MinWidth="0" HorizontalAlignment="Stretch">

                        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,22">
                            <TextBlock
                                Text="{Binding CurrentDirectory.Name}"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Foreground="#111827" />
                            <TextBlock
                                Text="Explore suas pastas e arquivos"
                                FontSize="13"
                                Foreground="#6B7280" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,22">
                            <TextBlock
                                Text="Pastas"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#1F2937" />

                            <ItemsControl ItemsSource="{Binding CurrentDirectory.Directories}"
                                          HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="model:Directory">
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Margin="0,0,12,12"
                                            Click="OnSelectFolder"
                                            DoubleTapped="OnFolderClick"
                                            ContextMenu="{StaticResource FolderContextMenu}"
                                            ContextRequested="OnFolderContextRequested"
                                            >
                                            <Border
                                                Width="160"
                                                Padding="12"
                                                Background="#F5F8FD"
                                                BorderBrush="#DAE3F0"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                ToolTip.Tip="{Binding Path}">
                                                <StackPanel Spacing="6">
                                                    <Image
                                                        Source="/Assets/directory.png"
                                                        Width="34"
                                                        Height="34"/>
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontWeight="SemiBold"
                                                        Foreground="#1F2937"
                                                        TextWrapping="Wrap"
                                                        TextTrimming="CharacterEllipsis"
                                                        MaxHeight="36" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="10" Margin="0,0,0,250">
                            <TextBlock
                                Text="Arquivos"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#1F2937" />

                            <ItemsControl ItemsSource="{Binding CurrentDirectory.Files}"
                                          HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="model:File">
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Margin="0,0,12,12"
                                            Click="OnSelectFile"
                                            DoubleTapped="OnFileClick"
                                            ContextMenu="{StaticResource FileContextMenu}"
                                            ContextRequested="OnFileContextRequested"
                                            >
                                            <Border
                                                Width="160"
                                                Padding="12"
                                                Background="#FFFFFF"
                                                BorderBrush="#E5EAF1"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                ToolTip.Tip="{Binding Path}">
                                                <StackPanel Spacing="6">
                                                    <Image
                                                        Source="/Assets/file.png"
                                                        Width="35"
                                                        Height="35"/>
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        Foreground="#374151"
                                                        TextWrapping="Wrap"
                                                        TextTrimming="CharacterEllipsis"
                                                        MaxHeight="36" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>

            <GridSplitter
                Grid.Column="3"
                Width="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ShowsPreview="True"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext" />

            <Border
                Grid.Column="4"
                Width="340"
                Background="#F8FAFC"
                BorderBrush="#E5EAF1"
                BorderThickness="1,0,0,0"
                Padding="16,18"
                IsVisible="{Binding HasSelection}">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14">

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        
                            <TextBlock
                                Grid.Column="0"
                                Text="Detalhes"
                                FontSize="16"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                Foreground="#111827"/>
                        
                            <Button
                                Grid.Column="1"
                                Click="OnCloseSelect"
                                Width="30"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#6B7280">
                                ✕
                            </Button>
                        </Grid>
                         
                        <Border
                            Background="#FFFFFF"
                            BorderBrush="#E5EAF1"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="16">

                            <StackPanel Spacing="14">

                                <Grid ColumnDefinitions="72,*" VerticalAlignment="Center">
                                    
                                    <Border
                                        Width="72"
                                        Height="72"
                                        Background="#EEF2F7"
                                        CornerRadius="18"
                                        BorderBrush="#E5EAF1"
                                        BorderThickness="1">
                                        <Image
                                            Source="{Binding SelectedIcon}"
                                            Width="36"
                                            Height="36"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                                        <TextBlock
                                            Text="{Binding SelectedName}"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Foreground="#111827"
                                            TextTrimming="CharacterEllipsis"/>
                                        <TextBlock
                                            Text="{Binding SelectedKind}"
                                            FontSize="12"
                                            Foreground="#6B7280"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="#E5EAF1" />

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Informações" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                                    <TextBlock Text="{Binding SelectedPath}" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedPrimaryInfo}" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock Text="{Binding SelectedModifiedText}" FontSize="12" Foreground="#6B7280"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <Border
                            Background="#FFFFFF"
                            BorderBrush="#E5EAF1"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Ações rápidas" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                                
                                <Button 
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10,9"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="OnFileClick"
                                    >
                                    <TextBlock Text="Abrir" Foreground="#1F2937"/>
                                </Button>

                                <Button     
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10,9"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="OnCopyPathClick"
                                            >
                                    <TextBlock Text="Copiar caminho" Foreground="#1F2937"/>
                                </Button>

                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10,9"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left">
                                    <TextBlock Text="Renomear" Foreground="#1F2937"/>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding HasVisibleCreateFolder}"
              Background="#40000000"
              ZIndex="999"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <Border Width="340"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F8FAFC"
                    BorderBrush="#E5EAF1"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">

                <StackPanel Spacing="16">

                    <TextBlock Text="Nova pasta"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <Border Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,8">

                        <TextBox Text="{Binding FolderName, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 PlaceholderText="Digite o nome da pasta"/>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10">

                        <Button Content="Cancelar"
                                Click="CancelCreateFolder"
                                Background="#111827"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="10"/>
                        
                        <Button Content="Criar pasta"
                                Click="CreateFolderCommand"
                                Background="#111827"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="10"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding HasVisibleCreateFile}"
              Background="#40000000"
              ZIndex="999"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <Border Width="340"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F8FAFC"
                    BorderBrush="#E5EAF1"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">

                <StackPanel Spacing="16">

                    <TextBlock Text="Novo Arquivo"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <Border Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,8">

                        <TextBox Text="{Binding FileName, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 PlaceholderText="Digite o nome da pasta"/>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10">

                        <Button Content="Cancelar"
                                Click="CancelCreateFile"
                                Background="#111827"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="10"/>
                        
                        <Button Content="Criar Arquivo"
                                Click="CreateFileCommand"
                                Background="#111827"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="10"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
        
    </Grid>
</UserControl>
                